{
    "compilerOptions": {
        "allowSyntheticDefaultImports": true,
        "composite": false,
        "declaration": true,
        "declarationMap": true,
        "diagnostics": true,
        "esModuleInterop": true,
        "extendedDiagnostics": false,
        "incremental": false,
        "jsx": "react-jsx",
        "lib": ["es2020", "dom", "dom.iterable"],
        "module": "esnext",
        "moduleResolution": "bundler",
        "noImplicitAny": true,
        "noImplicitReturns": true,
        "noImplicitThis": true,
        "outDir": "./dist/",
        "rootDir": "./src/",
        "paths": {
            "@/*": ["./src/*"],
            "*": ["./src/*"]
        },
        "preserveWatchOutput": false,
        "removeComments": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "sourceMap": true,
        "strict": true,
        "strictNullChecks": true,
        "strictPropertyInitialization": true,
        "target": "ES2020"
    },
    "output": ["./dist"],
    "files": ["src/index.tsx"],
    "include": [
        "./src/**/*.mdx",
        "./src/**/*.ts",
        "./src/**/*.tsx",
        "./src/**/*.css",
        "./src/**/*.svg",
        "./src/**/*.png",
        "./src/**/*.jpg",
        "./src/**/*.jpeg",
        "./src/**/*.gif",
        "./src/**/*.webp"
    ],
    "exclude": [
        "_backup_/",
        "node_modules/",
        "**/*.spec.*",
        "**/*.test.*",
        "**/*.SKIP.*"
    ]
}
