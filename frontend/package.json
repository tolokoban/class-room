{
    "name": "class-room",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "sideEffects": [
        "*.css"
    ],
    "homepage": "./",
    "dependencies": {
        "@huggingface/transformers": "^4.3.2",
        "@tanstack/react-query": "^5.105.0",
        "@tolokoban/react-state": "^0.9.0",
        "@tolokoban/tgd": "^2.9.0",
        "@tolokoban/type-guards": "^0.9.0",
        "@tolokoban/ui": "^0.25.12",
        "build-react-routes": "^0.14.0",
        "json5": "^2.2.3",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-markdown": "^10.1.0"
    },
    "scripts": {
        "activities": "node ../scripts/activities.mts",
        "embeddings": "node \"src/app/student/[classroom]/activity/AI/RAG/embedding/_/generate.mts\"",
        "perceptron": "node \"src/app/student/[classroom]/activity/AI/perceptron/_/train.mts\"",
        "generate": "npm run activities && npm run routes",
        "routes": "build-react-routes ./src/app",
        "analyse": "webpack --profile --json > stats.json",
        "start": "rspack serve --mode=development",
        "build": "rspack --mode=production",
        "format": "oxfmt",
        "lint": "oxlint",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "eslintConfig": {},
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "devDependencies": {
        "@rspack/cli": "^2.3.0",
        "@rspack/core": "^2.3.0",
        "@rspack/dev-server": "^2.2.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "clean-webpack-plugin": "^4.0.0",
        "css-loader": "^7.1.5",
        "gh-pages": "^6.3.0",
        "highlight.js": "^11.12.0",
        "oxfmt": "^0.75.0",
        "oxlint": "^1.90.0",
        "rehype-highlight": "^7.0.2",
        "rehype-highlight-code-lines": "^1.2.5",
        "remark-emoji": "^5.0.2",
        "remark-gfm": "^4.0.1",
        "remark-images": "^4.1.0",
        "ts-loader": "^9.6.2",
        "typescript": "^7.0.2",
        "vitest": "^5.0.5",
        "webpack-shell-plugin-next": "^2.3.3",
        "workbox-webpack-plugin": "^7.4.1"
    },
    "port": 37890
}