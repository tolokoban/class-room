/**
 * Helpers for the scripts that precompute the embeddings of an activity
 * (its `generate.mts`). They run with Node 24+, for `DataView.setFloat16`.
 */
import FS from "node:fs";
import Path from "node:path";

import { pipeline } from "@huggingface/transformers";

import { fisherLda } from "./lda.ts";
import { EMBEDDING_SIZE, MODEL_DTYPE, MODEL_ID, prepareText, type TextKind } from "./model.ts";
import type { Projection } from "./projection.ts";

/**
 * All the embeddings of an activity, one after the other.
 * They are referenced by their offset: the index of their first value.
 */
export class EmbeddingsStore {
  readonly values: number[] = [];
  // No parameter property in the constructor: Node's type stripping does not support them.
  private readonly extractor: Awaited<ReturnType<typeof makeExtractor>>;

  private constructor(extractor: Awaited<ReturnType<typeof makeExtractor>>) {
    this.extractor = extractor;
  }

  /** Download the model, the first time only (it is cached in `node_modules`). */
  static async create(): Promise<EmbeddingsStore> {
    return new EmbeddingsStore(await makeExtractor());
  }

  /**
   * Embed `texts` and append their vectors to the store.
   * @param kind The prefix to use, see `prepareText()`.
   * @returns The offsets of the embeddings of `texts`.
   */
  async embed(texts: string[], kind: TextKind = "query"): Promise<number[]> {
    const output = await this.extractor(
      texts.map((text) => prepareText(text, kind)),
      { pooling: "mean", normalize: true },
    );
    return (output.tolist() as number[][]).map((vector) => {
      if (vector.length !== EMBEDDING_SIZE) {
        throw new Error(`Expected vectors of size ${EMBEDDING_SIZE}, got ${vector.length}!`);
      }
      const offset = this.values.length;
      this.values.push(...vector);
      return offset;
    });
  }

  /** A copy of the embedding that starts at `offset`. */
  vectorAt(offset: number): number[] {
    return this.values.slice(offset, offset + EMBEDDING_SIZE);
  }

  /**
   * Write all the vectors in a binary file, as 16 bits floats in little endian.
   * They are precise enough for values between -1 and +1,
   * and the file is twice smaller than with 32 bits.
   */
  writeVectors(filename: string) {
    const { values } = this;
    const buffer = new ArrayBuffer(values.length * 2);
    const view = new DataView(buffer);
    values.forEach((value, index) => view.setFloat16(index * 2, value, true));
    FS.writeFileSync(filename, new Uint8Array(buffer));
    console.log("Written:", Path.basename(filename), `(${values.length / EMBEDDING_SIZE} vectors)`);
  }
}

/** The same model and settings as in the browser (see `model.ts`). */
function makeExtractor() {
  return pipeline("feature-extraction", MODEL_ID, { dtype: MODEL_DTYPE });
}

/**
 * Write a TypeScript file that exports `value` as a constant.
 * @param types Name of the type of the constant, and the module to import it from.
 */
export function writeTypeScript(
  filename: string,
  types: { name: string; from: string },
  name: string,
  value: unknown,
) {
  const content = `/**
 * This file is auto-generated by \`../generate.mts\`.
 * Model: ${MODEL_ID} (${MODEL_DTYPE})
 */
import type { ${types.name} } from "${types.from}";

export const ${name}: ${types.name} = ${JSON.stringify(value, null, 2)};
`;
  FS.writeFileSync(filename, content);
  console.log("Written:", Path.basename(filename));
}

/**
 * Fisher LDA on the groups of vectors (see `lda.ts`), for the 3D view.
 * Each axis is scaled and shifted so that the vectors span exactly [-1, +1] on it:
 * the cloud is centered in the view.
 * @param groups Each group is a list of vectors that belong together,
 * and get the same color in the view.
 */
export function fitProjection(groups: number[][][]): Projection {
  const { mean, axes } = fisherLda(groups, 3);
  const ranges = axes.map((axis) => {
    const coords = groups
      .flat()
      .map((vector) => vector.reduce((sum, x, i) => sum + (x - mean[i]) * axis[i], 0));
    const min = Math.min(...coords);
    const max = Math.max(...coords);
    return { scale: 2 / (max - min), middle: (min + max) / 2 };
  });
  const round = (x: number) => Number(x.toPrecision(6));
  return {
    mean: mean.map(round),
    axes: axes.map((axis, k) => axis.map((x) => round(x * ranges[k].scale))) as Projection["axes"],
    center: ranges.map(({ scale, middle }) => round(middle * scale)) as Projection["center"],
  };
}
