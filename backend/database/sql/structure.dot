      "classroom_user":f0 -> "classroom_user_role":f0 [style=invis, weight=100, color=red]
    "classroom_user":f1:e -> "classroom_user_role":f1:w [dir=forward, penwidth=3, color="#611da5", headlabel="*", taillabel="1"]
