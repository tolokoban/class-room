          <TD ALIGN="LEFT">name    </TD>
          <TD ALIGN="RIGHT"><FONT><I>VARCHAR(32)</I> <B>(!)</B></FONT></TD>
        </TR>
      </TABLE>
    </TD></TR>
    </TABLE>>];
